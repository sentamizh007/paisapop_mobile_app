{
  "expo": {
    "name": "PaisaPop",
    "slug": "paisapop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "paisapop",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#131927"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paisapop.expensetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "PaisaPop needs camera access to capture receipt photos for your expense tracking.",
        "NSPhotoLibraryUsageDescription": "PaisaPop needs photo library access to attach receipt images to your transactions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#131927"
      },
      "package": "com.paisapop.expensetracker",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-splash-screen",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "b24537b1-2011-4885-8348-76a7e7901bf5"
      }
    }
  }
}
