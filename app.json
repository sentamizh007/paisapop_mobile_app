{
  "expo": {
    "name": "PaisaPop",
    "slug": "ExpenseTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#131927"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paisapop.expensetracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#131927"
      },
      "package": "com.paisapop.expensetracker",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
